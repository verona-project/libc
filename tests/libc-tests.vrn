(import base)
(import testing)
(import libc)
(import libc.stdio :as io)
(import test.io :as files)
(import test.memory :as memory)
(import test.network :as network)
(import test.numeric :as numeric)
(import test.system :as system)
(import test.types :as types)

(base:function run-case ((name (pointer u8)) (test-case testing:test-function)) testing:result
  (let ((result testing:result (testing:execute test-case)))
    (match (field result failed) (0 result) (_ (do (io:puts name) result)))))

(base:function main () exit-code
  (let
    ((result
       testing:result
       (testing:checks
         (run-case "types/ABI strides" types:abi-strides)
         (run-case "constants/target values" types:target-constants)
         (run-case "memory/allocation and copy" memory:allocation-and-copy)
         (run-case "memory/overlapping move" memory:overlapping-move)
         (run-case "memory/aligned allocation" memory:aligned-allocation)
         (run-case "string/search" memory:string-search)
         (run-case "string/copy and tokenize" memory:string-copy-and-tokenize)
         (run-case "errno/failed close" files:error-state)
         (run-case "descriptor/pipe readiness" files:pipe-readiness)
         (run-case "stdio/buffered stream" files:buffered-stream)
         (run-case "filesystem/temporary file" files:temporary-file)
         (run-case "filesystem/directory entry" files:directory-entry)
         (run-case "math/numeric conversion" numeric:numeric-conversion)
         (run-case "math/results" numeric:math-results)
         (run-case "math/sort and search" numeric:sort-and-search)
         (run-case "time/calendar" numeric:calendar-time)
         (run-case "time/clocks" numeric:clocks)
         (run-case "network/IPv6 conversion" network:ipv6-conversion)
         (run-case "network/numeric lookup" network:numeric-address-lookup)
         (run-case "network/Unix socket pair" network:unix-socket-pair)
         (run-case "network/loopback connection" network:loopback-connection)
         (run-case "process/environment" system:environment)
         (run-case "process/child exit status" system:child-exit-status)
         (run-case "process/exec and wait" system:exec-and-wait)
         (run-case "pthread/thread lifecycle" system:thread-lifecycle)
         (run-case "pthread/synchronization" system:synchronization)
         (run-case "dynamic/symbol lookup" system:dynamic-symbols)
         (run-case "random/bounded output" system:bounded-random))))
    (match (field result failed)
      (0 (do (io:puts "libc tests passed") 0))
      (_ (do (io:puts "libc tests failed") 1)))))
