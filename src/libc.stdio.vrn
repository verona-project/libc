(import base)
(import libc.types :as types)

;; Buffered stdio streams and character I/O.
(base:external-function fopen "fopen" (types:c-string types:c-string) (pointer types:file-stream))

(base:external-function tmpfile "tmpfile" () (pointer types:file-stream))

(base:external-function fileno "fileno" ((pointer types:file-stream)) types:file-descriptor)

(base:external-function ferror "ferror" ((pointer types:file-stream)) types:c-int)

(base:external-function fclose "fclose" ((pointer types:file-stream)) types:c-int)

(base:external-function
  fread
  "fread"
  ((pointer void) types:size-t types:size-t (pointer types:file-stream))
  types:size-t)

(base:external-function
  fwrite
  "fwrite"
  ((pointer void) types:size-t types:size-t (pointer types:file-stream))
  types:size-t)

(base:external-function
  fgets
  "fgets"
  (types:c-string types:c-int (pointer types:file-stream))
  types:c-string)

(base:external-function fputs "fputs" (types:c-string (pointer types:file-stream)) types:c-int)

(base:external-function getchar "getchar" () types:c-int)

(base:external-function putchar "putchar" (types:c-int) types:c-int)

(base:external-function puts "puts" (types:c-string) types:c-int)

(base:external-function perror "perror" (types:c-string) void)

(base:external-function
  fdopen
  "fdopen"
  (types:file-descriptor types:c-string)
  (pointer types:file-stream))

(base:external-function fflush "fflush" ((pointer types:file-stream)) types:c-int)

(base:external-function feof "feof" ((pointer types:file-stream)) types:c-int)

(base:external-function clearerr "clearerr" ((pointer types:file-stream)) void)

(base:external-function fgetc "fgetc" ((pointer types:file-stream)) types:c-int)

(base:external-function fputc "fputc" (types:c-int (pointer types:file-stream)) types:c-int)

(base:external-function
  getline
  "getline"
  ((pointer types:c-string) (pointer types:size-t) (pointer types:file-stream))
  types:ssize-t)

(base:external-function
  fseeko
  "fseeko"
  ((pointer types:file-stream) types:off-t types:c-int)
  types:c-int)

(base:external-function ftello "ftello" ((pointer types:file-stream)) types:off-t)

(export
  fopen
  tmpfile
  fileno
  ferror
  fclose
  fread
  fwrite
  fgets
  fputs
  getchar
  putchar
  puts
  perror
  fdopen
  fflush
  feof
  clearerr
  fgetc
  fputc
  getline
  fseeko
  ftello)
