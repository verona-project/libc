(import base)
(import libc.types :as types)

;; NUL-terminated C-string functions.  c-string must point to a valid byte
;; sequence ending in zero.
(base:external-function strlen "strlen" (types:c-string) types:size-t)

(base:external-function strcmp "strcmp" (types:c-string types:c-string) types:c-int)

(base:external-function strncmp "strncmp" (types:c-string types:c-string types:size-t) types:c-int)

(base:external-function strcpy "strcpy" (types:c-string types:c-string) types:c-string)

(base:external-function
  strncpy
  "strncpy"
  (types:c-string types:c-string types:size-t)
  types:c-string)

(base:external-function strchr "strchr" (types:c-string types:c-int) types:c-string)

(base:external-function strstr "strstr" (types:c-string types:c-string) types:c-string)

(base:external-function strerror "strerror" (types:c-int) types:c-string)

(base:external-function strnlen "strnlen" (types:c-string types:size-t) types:size-t)

(base:external-function strdup "strdup" (types:c-string) types:c-string)

(base:external-function strndup "strndup" (types:c-string types:size-t) types:c-string)

(base:external-function strrchr "strrchr" (types:c-string types:c-int) types:c-string)

(base:external-function strcat "strcat" (types:c-string types:c-string) types:c-string)

(base:external-function
  strtok-r
  "strtok_r"
  (types:c-string types:c-string (pointer types:c-string))
  types:c-string)

(export
  strlen
  strcmp
  strncmp
  strcpy
  strncpy
  strchr
  strstr
  strerror
  strnlen
  strdup
  strndup
  strrchr
  strcat
  strtok-r)
