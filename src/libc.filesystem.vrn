(import base)
(import libc.types :as types)

;; Filesystem metadata and directory operations.  Structure types remain opaque
;; until their ABI layouts are modelled explicitly.
(base:external-function stat "stat" (types:c-string (pointer types:file-status)) types:c-int)

(base:external-function mkdir "mkdir" (types:c-string types:mode-t) types:c-int)

;; mkstemp modifies a writable template ending in XXXXXX and returns an open fd.
(base:external-function mkstemp "mkstemp" (types:c-string) types:file-descriptor)

(base:external-function unlink "unlink" (types:c-string) types:c-int)

(base:external-function rename "rename" (types:c-string types:c-string) types:c-int)

(base:external-function opendir "opendir" (types:c-string) (pointer types:directory-stream))

(base:external-function readdir "readdir" ((pointer types:directory-stream)) (pointer void))

(base:external-function closedir "closedir" ((pointer types:directory-stream)) types:c-int)

;; Process-local directory change keeps generated paths independent of name length.
(base:external-function chdir "chdir" ((pointer u8)) i32)

;; CREAT has a fixed C ABI, including on Darwin ARM64.
(base:external-function creat "creat" ((pointer u8) types:mode-t) i32)

(export stat mkdir mkstemp unlink rename opendir readdir closedir chdir creat)
