(import base)
(import libc.types :as types)

;; POSIX threads and synchronization. The attributes argument can be nil
;; to select the C library's defaults.
(base:external-function
  pthread-create
  "pthread_create"
  ((pointer types:pthread-thread)
   (pointer types:pthread-attributes)
   types:pthread-start-routine
   (pointer void))
  types:c-int)

(base:external-function
  pthread-join
  "pthread_join"
  (types:pthread-thread (pointer (pointer void)))
  types:c-int)

(base:external-function
  pthread-mutex-init
  "pthread_mutex_init"
  ((pointer types:pthread-mutex) (pointer types:pthread-mutex-attributes))
  types:c-int)

(base:external-function
  pthread-mutex-destroy
  "pthread_mutex_destroy"
  ((pointer types:pthread-mutex))
  types:c-int)

(base:external-function
  pthread-mutex-lock
  "pthread_mutex_lock"
  ((pointer types:pthread-mutex))
  types:c-int)

(base:external-function
  pthread-mutex-unlock
  "pthread_mutex_unlock"
  ((pointer types:pthread-mutex))
  types:c-int)

(base:external-function
  pthread-cond-init
  "pthread_cond_init"
  ((pointer types:pthread-condition) (pointer types:pthread-condition-attributes))
  types:c-int)

(base:external-function
  pthread-cond-destroy
  "pthread_cond_destroy"
  ((pointer types:pthread-condition))
  types:c-int)

(base:external-function
  pthread-cond-wait
  "pthread_cond_wait"
  ((pointer types:pthread-condition) (pointer types:pthread-mutex))
  types:c-int)

(base:external-function
  pthread-cond-signal
  "pthread_cond_signal"
  ((pointer types:pthread-condition))
  types:c-int)

(base:external-function
  pthread-cond-broadcast
  "pthread_cond_broadcast"
  ((pointer types:pthread-condition))
  types:c-int)

(base:external-function pthread-self "pthread_self" () types:pthread-thread)

(base:external-function
  pthread-equal
  "pthread_equal"
  (types:pthread-thread types:pthread-thread)
  types:c-int)

(base:external-function pthread-detach "pthread_detach" (types:pthread-thread) types:c-int)

(base:external-function
  pthread-mutex-trylock
  "pthread_mutex_trylock"
  ((pointer types:pthread-mutex))
  types:c-int)

(base:external-function
  pthread-cond-timedwait
  "pthread_cond_timedwait"
  ((pointer types:pthread-condition)
   (pointer types:pthread-mutex)
   (pointer types:time-specification))
  types:c-int)

(base:external-function
  pthread-attr-init
  "pthread_attr_init"
  ((pointer types:pthread-attributes))
  types:c-int)

(base:external-function
  pthread-attr-destroy
  "pthread_attr_destroy"
  ((pointer types:pthread-attributes))
  types:c-int)

(base:external-function
  pthread-mutexattr-init
  "pthread_mutexattr_init"
  ((pointer types:pthread-mutex-attributes))
  types:c-int)

(base:external-function
  pthread-mutexattr-destroy
  "pthread_mutexattr_destroy"
  ((pointer types:pthread-mutex-attributes))
  types:c-int)

(base:external-function
  pthread-condattr-init
  "pthread_condattr_init"
  ((pointer types:pthread-condition-attributes))
  types:c-int)

(base:external-function
  pthread-condattr-destroy
  "pthread_condattr_destroy"
  ((pointer types:pthread-condition-attributes))
  types:c-int)

(export
  pthread-create
  pthread-join
  pthread-mutex-init
  pthread-mutex-destroy
  pthread-mutex-lock
  pthread-mutex-unlock
  pthread-cond-init
  pthread-cond-destroy
  pthread-cond-wait
  pthread-cond-signal
  pthread-cond-broadcast
  pthread-self
  pthread-equal
  pthread-detach
  pthread-mutex-trylock
  pthread-cond-timedwait
  pthread-attr-init
  pthread-attr-destroy
  pthread-mutexattr-init
  pthread-mutexattr-destroy
  pthread-condattr-init
  pthread-condattr-destroy)
