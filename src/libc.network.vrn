(import base)
(import libc.types :as types)

;; Socket creation, address conversion, connection, and byte-stream I/O.
(base:external-function socket "socket" (types:c-int types:c-int types:c-int) types:file-descriptor)

(base:external-function htons "htons" (u16) u16)

(base:external-function inet-addr "inet_addr" (types:c-string) u32)

(base:external-function
  setsockopt
  "setsockopt"
  (types:file-descriptor types:c-int types:c-int (pointer void) types:socket-length-t)
  types:c-int)

(base:external-function
  bind
  "bind"
  (types:file-descriptor (pointer types:socket-address) types:socket-length-t)
  types:c-int)

(base:external-function listen "listen" (types:file-descriptor types:c-int) types:c-int)

(base:external-function
  accept
  "accept"
  (types:file-descriptor (pointer types:socket-address) (pointer types:socket-length-t))
  types:file-descriptor)

(base:external-function
  connect
  "connect"
  (types:file-descriptor (pointer types:socket-address) types:socket-length-t)
  types:c-int)

(base:external-function
  send
  "send"
  (types:file-descriptor (pointer void) types:size-t types:c-int)
  types:ssize-t)

(base:external-function
  recv
  "recv"
  (types:file-descriptor (pointer void) types:size-t types:c-int)
  types:ssize-t)

(base:external-function
  getaddrinfo
  "getaddrinfo"
  (types:c-string
    types:c-string
    (pointer types:address-info)
    (pointer (pointer types:address-info)))
  types:c-int)

(base:external-function freeaddrinfo "freeaddrinfo" ((pointer types:address-info)) void)

(base:external-function
  inet-pton
  "inet_pton"
  (types:c-int types:c-string (pointer void))
  types:c-int)

(base:external-function
  inet-ntop
  "inet_ntop"
  (types:c-int (pointer void) types:c-string types:socket-length-t)
  types:c-string)

(base:external-function shutdown "shutdown" (types:file-descriptor types:c-int) types:c-int)

(base:external-function
  getsockopt
  "getsockopt"
  (types:file-descriptor types:c-int types:c-int (pointer void) (pointer types:socket-length-t))
  types:c-int)

(base:external-function
  getsockname
  "getsockname"
  (types:file-descriptor (pointer types:socket-address) (pointer types:socket-length-t))
  types:c-int)

(base:external-function
  getpeername
  "getpeername"
  (types:file-descriptor (pointer types:socket-address) (pointer types:socket-length-t))
  types:c-int)

(base:external-function
  socketpair
  "socketpair"
  (types:c-int types:c-int types:c-int (pointer types:file-descriptor))
  types:c-int)

(base:external-function
  sendto
  "sendto"
  (types:file-descriptor
    (pointer void)
    types:size-t
    types:c-int
    (pointer types:socket-address)
    types:socket-length-t)
  types:ssize-t)

(base:external-function
  recvfrom
  "recvfrom"
  (types:file-descriptor
    (pointer void)
    types:size-t
    types:c-int
    (pointer types:socket-address)
    (pointer types:socket-length-t))
  types:ssize-t)

(base:external-function
  getnameinfo
  "getnameinfo"
  ((pointer types:socket-address)
   types:socket-length-t
   types:c-string
   types:socket-length-t
   types:c-string
   types:socket-length-t
   types:c-int)
  types:c-int)

(base:external-function gai-strerror "gai_strerror" (types:c-int) types:c-string)

#+linux (base:external-function
          accept4
          "accept4"
          (types:file-descriptor
            (pointer types:socket-address)
            (pointer types:socket-length-t)
            types:c-int)
          types:file-descriptor)

(export
  socket
  htons
  inet-addr
  setsockopt
  bind
  listen
  accept
  connect
  send
  recv
  getaddrinfo
  freeaddrinfo
  inet-pton
  inet-ntop
  shutdown
  getsockopt
  getsockname
  getpeername
  socketpair
  sendto
  recvfrom
  getnameinfo
  gai-strerror)

#+linux (export accept4)
