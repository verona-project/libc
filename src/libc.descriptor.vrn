(import base)
(import libc.types :as types)

;; Unbuffered file-descriptor I/O and descriptor duplication.
(base:external-function open "open" (types:c-string types:c-int types:mode-t) types:file-descriptor)

(base:external-function close "close" (types:file-descriptor) types:c-int)

(base:external-function
  read
  "read"
  (types:file-descriptor (pointer void) types:size-t)
  types:ssize-t)

(base:external-function
  write
  "write"
  (types:file-descriptor (pointer void) types:size-t)
  types:ssize-t)

(base:external-function lseek "lseek" (types:file-descriptor types:off-t types:c-int) types:off-t)

(base:external-function pipe "pipe" ((pointer types:file-descriptor)) types:c-int)

(base:external-function dup "dup" (types:file-descriptor) types:file-descriptor)

(base:external-function
  dup2
  "dup2"
  (types:file-descriptor types:file-descriptor)
  types:file-descriptor)

(base:external-function
  pread
  "pread"
  (types:file-descriptor (pointer void) types:size-t types:off-t)
  types:ssize-t)

(base:external-function
  pwrite
  "pwrite"
  (types:file-descriptor (pointer void) types:size-t types:off-t)
  types:ssize-t)

(base:external-function fsync "fsync" (types:file-descriptor) types:c-int)

(base:external-function ftruncate "ftruncate" (types:file-descriptor types:off-t) types:c-int)

(base:external-function isatty "isatty" (types:file-descriptor) types:c-int)

(base:external-function
  poll
  "poll"
  ((pointer types:poll-descriptor) types:poll-count-t types:c-int)
  types:c-int)

(export open close read write lseek pipe dup dup2 pread pwrite fsync ftruncate isatty poll)
